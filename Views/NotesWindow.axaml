<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ScriptAppDashboard.Views"
        x:Class="ScriptAppDashboard.Views.NotesWindow"
        Title="Notes"
        Width="1040" Height="620"
        MinWidth="760" MinHeight="400"
        Icon="/Assets/icon.png"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <!-- title and tags sit on the page like a document heading -->
    <Style Selector="TextBox.doc">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="2,2"/>
    </Style>
    <Style Selector="TextBox.doc /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.doc:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.doc:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <!-- toolbar buttons don't take focus, so the caret and selection stay in the note -->
    <Style Selector="WrapPanel#FormatBar > Button">
      <Setter Property="Margin" Value="0,0,4,4"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="260,*" Margin="16">
    <DockPanel Grid.Column="0" Margin="0,0,12,0">
      <Button DockPanel.Dock="Top" Content="New note" Classes="accent" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Click="New_Click"/>
      <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,8" Watermark="Search title, tags, text…"/>
      <TextBlock DockPanel.Dock="Bottom" Margin="0,2,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                 Text="Ctrl+S save · Ctrl+N new · Ctrl+F search · Ctrl+B / I / K bold, italic, link"/>
      <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Margin="0,6,0,0" FontSize="12" Foreground="Gray"/>
      <Panel>
        <ListBox x:Name="NoteList" SelectionChanged="NoteList_Changed"/>
        <TextBlock x:Name="EmptyHint" Margin="12" TextWrapping="Wrap" TextAlignment="Center"
                   VerticalAlignment="Center" Foreground="Gray" IsHitTestVisible="False"/>
      </Panel>
    </DockPanel>

    <DockPanel Grid.Column="1">
      <WrapPanel x:Name="FormatBar" DockPanel.Dock="Top">
        <Button Content="B" FontWeight="Bold" MinWidth="32" AutomationProperties.Name="Bold"
                ToolTip.Tip="Bold (Ctrl+B)" Click="Bold_Click"/>
        <Button Content="I" FontStyle="Italic" MinWidth="32" AutomationProperties.Name="Italic"
                ToolTip.Tip="Italic (Ctrl+I)" Click="Italic_Click"/>
        <Button Content="&lt;/&gt;" AutomationProperties.Name="Code"
                ToolTip.Tip="Code — selected text becomes inline code, otherwise the line becomes a code block (or type ```)" Click="Code_Click"/>
        <Button Content="Link" ToolTip.Tip="Link (Ctrl+K) — Ctrl+click a link to open it" Click="Link_Click"/>
        <Button Content="H" FontWeight="Bold" MinWidth="32" AutomationProperties.Name="Heading"
                ToolTip.Tip="Heading — click again for a smaller one (or type #, ## or ### and a space)" Click="Heading_Click"/>
        <Button Content="❝" MinWidth="32" AutomationProperties.Name="Quote"
                ToolTip.Tip="Quote (or type &gt; and a space)" Click="Quote_Click"/>
        <Button Content="• Bullets" ToolTip.Tip="Bulleted list (or type - and a space) — Tab indents, Enter on an empty item ends the list" Click="Bullets_Click"/>
        <Button Content="1. Numbers" ToolTip.Tip="Numbered list (or type 1. and a space)" Click="Numbers_Click"/>
        <Button Content="◷ Timed" ToolTip.Tip="Time bullets — every new item (Enter) is stamped with the current date and time" Click="Timed_Click"/>
        <Button x:Name="TimeButton" Content="🕒 Time" ToolTip.Tip="Insert the current time (format in Settings)"
                Click="Time_Click"/>
        <Button x:Name="AiButton" Content="✨ AI ▾" AutomationProperties.Name="AI"
                ToolTip.Tip="AI: rewrite, shorten, fix or translate the selected text (or the whole note), continue writing, summarise, extract to-dos, make meeting minutes, suggest a title and tags"
                Click="Ai_Click">
          <FlyoutBase.AttachedFlyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem x:Name="AiScopeItem" Header="On the selected text" IsEnabled="False"/>
              <MenuItem Header="Improve writing" Tag="improve" Click="AiAction_Click"/>
              <MenuItem Header="Shorten" Tag="shorten" Click="AiAction_Click"/>
              <MenuItem Header="Fix spelling and grammar" Tag="fix" Click="AiAction_Click"/>
              <MenuItem Header="Translate to">
                <MenuItem Header="English" Tag="translate:English" Click="AiAction_Click"/>
                <MenuItem Header="Vietnamese (Tiếng Việt)" Tag="translate:Vietnamese" Click="AiAction_Click"/>
                <MenuItem Header="Japanese (日本語)" Tag="translate:Japanese" Click="AiAction_Click"/>
                <MenuItem Header="Chinese, Simplified (简体中文)" Tag="translate:Simplified Chinese" Click="AiAction_Click"/>
                <MenuItem Header="Korean (한국어)" Tag="translate:Korean" Click="AiAction_Click"/>
                <MenuItem Header="French (Français)" Tag="translate:French" Click="AiAction_Click"/>
                <MenuItem Header="German (Deutsch)" Tag="translate:German" Click="AiAction_Click"/>
                <MenuItem Header="Spanish (Español)" Tag="translate:Spanish" Click="AiAction_Click"/>
              </MenuItem>
              <MenuItem Header="Continue writing" Tag="continue" Click="AiAction_Click"/>
              <Separator/>
              <MenuItem Header="Summarize the note" Tag="summary" Click="AiAction_Click"/>
              <MenuItem Header="Extract to-dos" Tag="todos" Click="AiAction_Click"/>
              <MenuItem Header="Turn into meeting minutes" Tag="minutes" Click="AiAction_Click"/>
              <MenuItem Header="Suggest a title and tags" Tag="title" Click="AiAction_Click"/>
            </MenuFlyout>
          </FlyoutBase.AttachedFlyout>
        </Button>
      </WrapPanel>
      <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Export ▾" ToolTip.Tip="Export this note as Markdown or HTML">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="This note as Markdown…" Click="ExportCurrent_Click"/>
                <MenuItem Header="This note as HTML…" Click="ExportHtml_Click"/>
                <MenuItem x:Name="ExportListMenu" Header="All notes as Markdown…" Click="ExportList_Click"/>
                <MenuItem Header="Copy this note as Markdown" Click="CopyMarkdown_Click"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="CodeToggleButton" Content="Edit HTML" Click="CodeToggle_Click"
                  ToolTip.Tip="Switch between the visual editor and the note's HTML source"/>
          <Button Content="Preview in browser" Click="Preview_Click"/>
          <Button Content="Delete" Click="Delete_Click"/>
          <Button Content="Save" Classes="accent" Click="Save_Click"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
      </DockPanel>
      <TextBox x:Name="TitleBox" DockPanel.Dock="Top" Classes="doc" Margin="0,6,0,0" Watermark="Title"
               FontSize="24" FontWeight="SemiBold"/>
      <TextBox x:Name="TagsBox" DockPanel.Dock="Top" Classes="doc" Foreground="Gray"
               Watermark="#tags (space or comma separated)"/>
      <Border DockPanel.Dock="Top" Height="1" Background="#44888888" Margin="0,6"/>
      <Panel>
        <views:NoteEditor x:Name="Editor"/>
        <TextBox x:Name="HtmlBox" IsVisible="False" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace"
                 Watermark="&lt;h3&gt;Idea&lt;/h3&gt;&lt;p&gt;Remember to …&lt;/p&gt;"/>
      </Panel>
    </DockPanel>
  </Grid>
</Window>
