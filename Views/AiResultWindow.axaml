<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScriptAppDashboard.Views.AiResultWindow"
        Title="AI"
        Width="680" Height="560"
        MinWidth="440" MinHeight="300"
        Icon="/Assets/icon.png"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <TextBlock x:Name="HeadingText" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock DockPanel.Dock="Top" Margin="0,2,0,8" FontSize="12" Foreground="Gray" TextWrapping="Wrap"
               Text="You can edit the answer before using it."/>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel x:Name="ButtonHost" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button x:Name="RetryButton" Content="Try again" Click="Retry_Click" IsEnabled="False"/>
        <Button x:Name="CopyButton" Content="Copy" Click="Copy_Click" IsEnabled="False"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="Gray"
                 TextWrapping="Wrap" Margin="0,0,12,0"/>
    </DockPanel>
    <TextBox x:Name="ResultBox" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="AI answer"/>
  </DockPanel>
</Window>
