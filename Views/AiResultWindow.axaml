<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScriptAppDashboard.Views.AiResultWindow"
        Title="AI"
        Width="680" Height="560"
        MinWidth="440" MinHeight="300"
        Icon="/Assets/icon.png"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <TextBlock x:Name="HeadingText" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock DockPanel.Dock="Top" Margin="0,2,0,8" FontSize="12" Foreground="Gray" TextWrapping="Wrap"
               Text="Check the answer, then choose what to do with it. Edit changes the text first."/>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel x:Name="ButtonHost" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button x:Name="EditButton" Content="✎ Edit" Click="Edit_Click" IsEnabled="False" IsVisible="False"
                AutomationProperties.Name="Edit the answer"
                ToolTip.Tip="Switch between the formatted answer and its editable text"/>
        <Button x:Name="RetryButton" Content="Try again" Click="Retry_Click" IsEnabled="False"/>
        <Button x:Name="CopyButton" Content="Copy" Click="Copy_Click" IsEnabled="False"/>
        <Button x:Name="SpeakButton" Content="🔊 Speak" Click="Speak_Click" IsEnabled="False"
                AutomationProperties.Name="Speak the answer"
                ToolTip.Tip="Read the selected text (or the whole answer) aloud; click again to stop"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="Gray"
                 TextWrapping="Wrap" Margin="0,0,12,0"/>
    </DockPanel>
    <Panel>
      <TextBox x:Name="ResultBox" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="AI answer"/>
      <ContentControl x:Name="PreviewHost" IsVisible="False" AutomationProperties.Name="AI answer preview"/>
    </Panel>
  </DockPanel>
</Window>
