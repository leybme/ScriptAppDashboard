<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ScriptAppDashboard.Views.NoteEditor">
  <UserControl.Styles>
    <!-- block text boxes look like the rendered text around them: no border, background or padding -->
    <Style Selector="TextBox.blk">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="AcceptsReturn" Value="True"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style Selector="TextBox.blk /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.blk:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.blk:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.stamp">
      <Setter Property="AcceptsReturn" Value="False"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
    <Grid>
      <!-- long lines are hard to read: the note keeps a book-like width on wide windows -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="920"/>
      </Grid.ColumnDefinitions>
      <StackPanel Margin="2,4,16,4">
        <StackPanel x:Name="BlockHost"/>
        <!-- clicking below the last block continues the note there -->
        <Border x:Name="Filler" MinHeight="160" Background="Transparent" Cursor="Ibeam"/>
        <!-- "/" on an empty line: pick the kind of block (the line keeps the focus) -->
        <Popup x:Name="SlashPopup" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="False">
          <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="#66808080"
                  BorderThickness="1" CornerRadius="6" Padding="4" Width="280">
            <ListBox x:Name="SlashList" Focusable="False" Background="Transparent" MaxHeight="330"
                     AutomationProperties.Name="Block types"/>
          </Border>
        </Popup>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
