<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScriptAppDashboard.Views.QuickAskWindow"
        Title="Ask AI"
        Width="640" Height="520"
        MinWidth="420" MinHeight="320"
        Icon="/Assets/icon.png"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="16">
    <TextBox x:Name="PromptBox" DockPanel.Dock="Top" AcceptsReturn="True" TextWrapping="Wrap"
             MinHeight="70" MaxHeight="200" AutomationProperties.Name="Question"
             Watermark="Ask anything…  Enter sends, Shift+Enter starts a new line"/>
    <DockPanel DockPanel.Dock="Top" Margin="0,8,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button x:Name="NewChatButton" Content="New chat" Click="NewChat_Click"
                ToolTip.Tip="Forget the previous questions and answers"/>
        <Button x:Name="AskButton" Content="Ask" Classes="accent" Click="Ask_Click" MinWidth="70"
                HorizontalContentAlignment="Center"/>
      </StackPanel>
      <WrapPanel VerticalAlignment="Center">
        <CheckBox x:Name="ClipboardCheck" Content="Include clipboard" Margin="0,0,12,0"
                  ToolTip.Tip="Send the text on the clipboard along with the question"/>
        <CheckBox x:Name="WindowCheck" Content="Include active window" Margin="0,0,12,0"/>
      </WrapPanel>
    </DockPanel>
    <TextBlock x:Name="HintText" DockPanel.Dock="Top" Margin="0,6,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button x:Name="CopyButton" Content="Copy answer" Click="Copy_Click" IsEnabled="False"/>
        <Button x:Name="NoteButton" Content="Save as note" Click="SaveNote_Click" IsEnabled="False"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="Gray"
                 TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <TextBox x:Name="AnswerBox" Margin="0,10,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
             AutomationProperties.Name="Answer" Watermark="The answer appears here."/>
  </DockPanel>
</Window>
