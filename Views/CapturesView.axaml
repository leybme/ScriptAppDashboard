<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScriptAppDashboard.Views.CapturesWindow"
        Title="Captures"
        Width="980" Height="680"
        MinWidth="520" MinHeight="360"
        Icon="/Assets/icon.png"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
        <Button x:Name="RegionButton" Content="Capture region" Classes="accent" Click="Region_Click"
                AutomationProperties.Name="Capture region" ToolTip.Tip="Drag over part of the screen"/>
        <Button x:Name="ScreenButton" Content="Whole screen" Click="Screen_Click"
                AutomationProperties.Name="Capture whole screen"/>
        <Button x:Name="ImportButton" Content="Open picture…" Click="Import_Click"
                AutomationProperties.Name="Open picture" ToolTip.Tip="Annotate a picture file"/>
        <Button x:Name="PasteButton" Content="Paste picture" Click="Paste_Click"
                AutomationProperties.Name="Paste picture" ToolTip.Tip="Annotate the picture on the clipboard"/>
      </StackPanel>
      <TextBox x:Name="QueryBox" AutomationProperties.Name="Search captures"
               Watermark="Search annotations, titles, tags and the text in the pictures…"/>
    </DockPanel>
    <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" Margin="2,8,0,8" FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <WrapPanel x:Name="Cards"/>
    </ScrollViewer>
  </DockPanel>
</Window>
