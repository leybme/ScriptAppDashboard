<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScriptAppDashboard.Views.AiScriptWindow"
        Title="New Script with AI"
        Width="760" Height="680"
        MinWidth="520" MinHeight="460"
        Icon="/Assets/icon.png"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <TextBlock Text="What should the script do?"/>
      <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
               AutomationProperties.Name="Description"
               Watermark="e.g. Delete files older than 30 days from my Downloads folder, but show the list and ask first"/>
      <DockPanel>
        <Button x:Name="GenerateButton" DockPanel.Dock="Right" Content="✨ Write it" Classes="accent" Margin="8,0,0,0"
                Click="Generate_Click"/>
        <TextBlock Text="Language" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="LanguageCombo" SelectedIndex="0" MinWidth="200"/>
      </DockPanel>
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Content="Cancel" Click="Cancel_Click"/>
        <Button x:Name="SaveButton" Content="Save and add tile" Classes="accent" IsEnabled="False" Click="Save_Click"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                 Margin="0,0,12,0"/>
    </DockPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,2*,Auto" Margin="0,10,0,0">
      <TextBlock Text="File" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="FileNameBox" Grid.Column="1" AutomationProperties.Name="File name"/>
      <TextBlock Grid.Column="2" Text="in" VerticalAlignment="Center" Margin="8,0"/>
      <TextBox x:Name="FolderBox" Grid.Column="3" AutomationProperties.Name="Folder"/>
      <Button Grid.Column="4" Content="Browse…" Margin="8,0,0,0" Click="BrowseFolder_Click"/>
    </Grid>

    <DockPanel Margin="0,12,0,0">
      <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                 Text="Read the script before you save it — AI can make mistakes. Saving doesn't run it; you start it from its tile."/>
      <TextBox x:Name="CodeBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
               FontFamily="Consolas,Menlo,monospace" AutomationProperties.Name="Script"/>
    </DockPanel>
  </DockPanel>
</Window>
