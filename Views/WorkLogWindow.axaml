<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScriptAppDashboard.Views.WorkLogWindow"
        Title="Work Log"
        Width="760" Height="600"
        Icon="/Assets/icon.png"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="16">
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <ComboBox x:Name="RangeCombo" SelectedIndex="0" MinWidth="140" Margin="0,0,8,0"
                SelectionChanged="Range_Changed">
        <ComboBoxItem Content="Today"/>
        <ComboBoxItem Content="Last 7 days"/>
        <ComboBoxItem Content="Last 30 days"/>
      </ComboBox>
      <CheckBox x:Name="WorkHoursCheck" Content="Working hours only" Margin="0,0,12,0" VerticalAlignment="Center"/>
      <Button Content="Refresh" Margin="0,0,8,0" Click="Refresh_Click"/>
      <Button Content="Copy summary (Markdown)" Margin="0,0,8,0" Click="Copy_Click"/>
      <Button Content="Open log folder" Margin="0,0,8,0" Click="OpenFolder_Click"/>
      <CheckBox x:Name="EnabledCheck" Content="Record work log" VerticalAlignment="Center"/>
    </WrapPanel>
    <TextBlock x:Name="InfoText" DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="12" Foreground="Gray"
               TextWrapping="Wrap"/>
    <ScrollViewer>
      <StackPanel x:Name="ReportHost" Spacing="4"/>
    </ScrollViewer>
  </DockPanel>
</Window>
