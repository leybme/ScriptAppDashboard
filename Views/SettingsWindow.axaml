<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScriptAppDashboard.Views.SettingsWindow"
        Title="Settings"
        Width="620" Height="520"
        MinWidth="520" MinHeight="420"
        Icon="/Assets/icon.png"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Content="Close" Click="Close_Click"/>
        <Button Content="Save" Classes="accent" Click="Save_Click"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
    </DockPanel>

    <TabControl>
      <TabItem Header="General">
        <ScrollViewer>
        <StackPanel Spacing="12" Margin="4,16,4,0">
          <CheckBox x:Name="StartupCheck" Content="Start with the system (hidden in the tray)"/>
          <TextBlock Text="Settings and scripts on this PC are stored in:" FontSize="12" Foreground="Gray"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Open folder" Margin="8,0,0,0" Click="OpenConfigFolder_Click"/>
            <TextBox x:Name="ConfigPathBox" IsReadOnly="True"/>
          </DockPanel>

          <TextBlock Text="Data folder — notes, pictures and the work log" FontWeight="SemiBold" Margin="0,8,0,0"/>
          <TextBlock FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                     Text="Put it in OneDrive (or Dropbox, Google Drive…) to have the same notes on several PCs. Each PC keeps its own work-log file in it; the Work Log adds them up. When you change the folder, your notes, pictures and work log are copied there and the app restarts."/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Open" Margin="8,0,0,0" Click="OpenDataFolder_Click"/>
            <TextBox x:Name="DataPathBox" IsReadOnly="True" AutomationProperties.Name="Data folder"/>
          </DockPanel>
          <WrapPanel>
            <Button x:Name="OneDriveButton" Content="Use OneDrive" Margin="0,0,8,4" Click="UseOneDrive_Click"
                    ToolTip.Tip="Keep the data in a ScriptAppDashboard folder in your OneDrive"/>
            <Button Content="Choose folder…" Margin="0,0,8,4" Click="ChooseDataFolder_Click"/>
            <Button Content="Only this PC" Margin="0,0,8,4" Click="LocalDataFolder_Click"
                    ToolTip.Tip="Keep the data in the settings folder above (not synced)"/>
          </WrapPanel>
          <CheckBox x:Name="SyncTimersCheck"
                    Content="Share the interval timers through this folder too (every PC gets the same timers)"/>
          <TextBlock x:Name="DataFolderText" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Timestamp">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="4,16,4,0">
            <CheckBox x:Name="TsEnabledCheck"
                      Content="Show the “Copy time” button (main window) and “Time” button (notes)"/>

            <TextBlock Text="Quick formats"/>
            <ComboBox x:Name="PresetCombo" HorizontalAlignment="Stretch" PlaceholderText="Choose a preset…"
                      SelectionChanged="Preset_Changed"/>

            <TextBlock Text="Format"/>
            <TextBox x:Name="FormatBox" FontFamily="Consolas,Menlo,monospace" TextChanged="Format_Changed"/>

            <Border CornerRadius="6" Padding="12" Background="#14888888">
              <StackPanel Spacing="2">
                <TextBlock Text="Preview (what the button copies)" FontSize="12" Foreground="Gray"/>
                <TextBlock x:Name="PreviewText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <TextBlock Text="Time-bullet format (the ◷ lines in notes — each new item gets the current time)" Margin="0,8,0,0"/>
            <TextBox x:Name="BulletFormatBox" FontFamily="Consolas,Menlo,monospace" TextChanged="Format_Changed"/>
            <TextBlock x:Name="BulletPreviewText" FontSize="13" Foreground="Gray"/>

            <TextBlock FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                       Text="yyyy year · MM month · dd day · HH hour (24h) · hh hour (12h) · tt AM/PM · mm minute · ss second · ddd weekday · MMM month name · zzz UTC offset. Use {DAY} for an uppercase weekday (MON, TUE…).&#10;Put text around the time with braces: [{DAY} {HH:mm}] Standup → [MON 09:30] Standup. Only the parts inside { } are formatted."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Work log">
        <ScrollViewer>
        <StackPanel Spacing="10" Margin="4,16,4,0">
          <CheckBox x:Name="LogEnabledCheck" Content="Record the work log (foreground app, window titles, open windows)"/>
          <TextBlock Text="Sample every (seconds)"/>
          <NumericUpDown x:Name="SampleBox" Minimum="5" Maximum="600" Increment="5" FormatString="0"
                         HorizontalAlignment="Left" MinWidth="160"/>
          <TextBlock Text="Count as idle after (minutes without keyboard / mouse)"/>
          <NumericUpDown x:Name="IdleBox" Minimum="1" Maximum="240" Increment="1" FormatString="0"
                         HorizontalAlignment="Left" MinWidth="160"/>
          <TextBlock FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                     Text="Changes to the sampling interval apply as soon as you press Save. Window titles are stored in the data folder (General tab) — only on this PC unless you chose a synced folder."/>

          <TextBlock Text="Working hours" FontWeight="SemiBold" Margin="0,10,0,0"/>
          <TextBlock FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                     Text="Everything is still recorded; the Work Log's “Working hours only” option counts just this time. An end before the start (e.g. 22:00 – 06:00) runs past midnight."/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="From" VerticalAlignment="Center"/>
            <TextBox x:Name="WorkStartBox" Width="80" Watermark="09:00" TextChanged="WorkHours_Changed"/>
            <TextBlock Text="to" VerticalAlignment="Center"/>
            <TextBox x:Name="WorkEndBox" Width="80" Watermark="18:00" TextChanged="WorkHours_Changed"/>
          </StackPanel>
          <WrapPanel x:Name="WorkDaysPanel"/>
          <TextBlock x:Name="WorkHoursPreview" FontSize="12" Foreground="Gray"/>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="AI">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="4,16,4,0">
            <TextBlock Text="AI provider"/>
            <DockPanel>
              <Button x:Name="TestAiButton" DockPanel.Dock="Right" Content="Test" Margin="8,0,0,0" Click="TestAi_Click"
                      ToolTip.Tip="Send a short test prompt and show the answer"/>
              <ComboBox x:Name="AiProviderCombo" HorizontalAlignment="Stretch" SelectionChanged="AiProvider_Changed">
                <ComboBoxItem Content="Claude (Claude Code CLI)" Tag="claude"/>
                <ComboBoxItem Content="Kiro — coming in a later version" Tag="kiro" IsEnabled="False"/>
                <ComboBoxItem Content="Custom command" Tag="custom"/>
              </ComboBox>
            </DockPanel>

            <StackPanel x:Name="AiModelPanel" Spacing="10">
              <TextBlock Text="Model"/>
              <ComboBox x:Name="AiModelCombo" HorizontalAlignment="Stretch" SelectionChanged="AiProvider_Changed"/>
            </StackPanel>

            <StackPanel x:Name="AiCustomPanel" Spacing="10" IsVisible="False">
              <TextBlock Text="Command (reads the prompt on standard input, prints the answer)"/>
              <TextBox x:Name="AiCommandBox" FontFamily="Consolas,Menlo,monospace" Watermark="ollama run llama3"/>
            </StackPanel>

            <TextBlock x:Name="AiCommandPreview" FontSize="12" Foreground="Gray" FontFamily="Consolas,Menlo,monospace"/>
            <TextBlock x:Name="AiTestText" FontSize="12" TextWrapping="Wrap" IsVisible="False"/>
            <TextBlock FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                       Text="Claude runs the Claude Code CLI in print mode (claude -p). Install it with npm install -g @anthropic-ai/claude-code and sign in once by running claude in a terminal. Haiku answers fastest and costs least; pick a larger model for better writing and reports."/>

            <TextBlock Text="Answer in" Margin="0,6,0,0"/>
            <TextBox x:Name="AiLanguageBox" Watermark="the language of the content (e.g. English, Vietnamese)"/>

            <TextBlock Text="“Ask AI” hotkey" Margin="0,6,0,0"/>
            <TextBox x:Name="AiHotkeyBox" Watermark="Ctrl+Alt+Space — leave empty for none"/>
            <TextBlock x:Name="AiHotkeyText" FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>

            <CheckBox x:Name="AiAutoTitleCheck" Margin="0,6,0,0"
                      Content="Give notes saved without a title an AI title and tags"/>
            <CheckBox x:Name="AiDaySummaryCheck" Content="End-of-day summary: when working hours end, write an AI report of the day into a note"/>
            <TextBlock x:Name="AiDaySummaryText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="28,-6,0,0"/>

            <Border CornerRadius="6" Padding="12" Background="#14888888" Margin="0,8,0,0">
              <TextBlock FontSize="12" TextWrapping="Wrap"
                         Text="Privacy: what you send leaves this computer when the command is a cloud AI. That is the selected note text, the window titles of the work log in reports and {today_summary}, scripts you ask to explain, and the clipboard when you include it. Nothing is sent unless you use an AI feature, or turn on the automatic title / day summary above, or set up an AI timer."/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
