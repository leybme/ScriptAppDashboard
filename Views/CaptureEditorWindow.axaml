<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="ScriptAppDashboard.Views.CaptureEditorWindow"
        Title="Capture"
        Width="1180" Height="780"
        MinWidth="760" MinHeight="480"
        Icon="/Assets/icon.png"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <!-- toolbar buttons keep the focus where it was, so a text box does not lose its caret -->
    <Style Selector="ToggleButton.tool, Button.tool">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>
  </Window.Styles>
  <DockPanel>
    <!-- tools -->
    <Border DockPanel.Dock="Top" Padding="10,8" Background="#18808080">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
          <Button x:Name="UndoButton" Classes="tool" AutomationProperties.Name="Undo" ToolTip.Tip="Undo (Ctrl+Z)" Click="Undo_Click">
            <materialIcons:MaterialIcon Kind="Undo" Width="16" Height="16"/>
          </Button>
          <Button x:Name="RedoButton" Classes="tool" AutomationProperties.Name="Redo" ToolTip.Tip="Redo (Ctrl+Y)" Click="Redo_Click">
            <materialIcons:MaterialIcon Kind="Redo" Width="16" Height="16"/>
          </Button>
          <Button Classes="tool" AutomationProperties.Name="Delete annotation" ToolTip.Tip="Delete the selected annotation (Delete)" Click="DeleteAnnotation_Click">
            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16"/>
          </Button>
          <Button Classes="tool" AutomationProperties.Name="Zoom out" ToolTip.Tip="Zoom out" Click="ZoomOut_Click">
            <materialIcons:MaterialIcon Kind="MagnifyMinusOutline" Width="16" Height="16"/>
          </Button>
          <Button x:Name="ZoomText" Classes="tool" AutomationProperties.Name="Fit to window" ToolTip.Tip="Fit the picture to the window" MinWidth="56" Content="Fit" Click="ZoomFit_Click"/>
          <Button Classes="tool" AutomationProperties.Name="Zoom in" ToolTip.Tip="Zoom in" Click="ZoomIn_Click">
            <materialIcons:MaterialIcon Kind="MagnifyPlusOutline" Width="16" Height="16"/>
          </Button>
        </StackPanel>
        <WrapPanel x:Name="ToolHost" Orientation="Horizontal"/>
      </DockPanel>
    </Border>

    <!-- colour, line width, text size -->
    <Border DockPanel.Dock="Top" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="#30808080">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="Colour" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7"/>
        <StackPanel x:Name="ColorHost" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
        <TextBlock Text="Line" VerticalAlignment="Center" Margin="20,0,8,0" Opacity="0.7"/>
        <Slider x:Name="WidthSlider" Minimum="1" Maximum="20" Value="4" Width="110" VerticalAlignment="Center"
                AutomationProperties.Name="Line width" ToolTip.Tip="Line width"/>
        <TextBlock Text="Text size" VerticalAlignment="Center" Margin="20,0,8,0" Opacity="0.7"/>
        <Slider x:Name="FontSlider" Minimum="10" Maximum="96" Value="28" Width="110" VerticalAlignment="Center"
                AutomationProperties.Name="Text size" ToolTip.Tip="Text size"/>
      </WrapPanel>
    </Border>

    <!-- one fixed line, so a longer hint never changes the size of the picture area -->
    <TextBlock x:Name="HintText" DockPanel.Dock="Top" Height="24" Padding="12,4,12,0" FontSize="12" Opacity="0.6"
               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

    <!-- status and actions -->
    <Border DockPanel.Dock="Bottom" Padding="10,8" BorderThickness="0,1,0,0" BorderBrush="#30808080">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CopyButton" Content="Copy image" Click="Copy_Click" ToolTip.Tip="Copy the annotated picture (Ctrl+C when the picture has focus)"/>
          <Button x:Name="SaveAsButton" Content="Save as…" Click="SaveAs_Click" ToolTip.Tip="Save the annotated picture as a PNG file"/>
          <Button x:Name="NoteButton" Content="New note with image" Click="Note_Click" ToolTip.Tip="Put the annotated picture in a new note"/>
          <Button x:Name="DeleteButton" Content="Delete capture" Click="DeleteCapture_Click"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>

    <!-- details and AI -->
    <ScrollViewer DockPanel.Dock="Right" Width="310" HorizontalScrollBarVisibility="Disabled" Padding="0">
      <StackPanel Margin="12,10" Spacing="6">
        <TextBlock Text="Selected annotation" FontWeight="SemiBold"/>
        <TextBox x:Name="AnnotationTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140"
                 AutomationProperties.Name="Annotation text" IsEnabled="False"
                 Watermark="Select a shape to give it words (searchable later)"/>
        <StackPanel x:Name="StepPanel" Orientation="Horizontal" Spacing="8" IsVisible="False">
          <TextBlock Text="Step number" VerticalAlignment="Center"/>
          <NumericUpDown x:Name="StepBox" Minimum="1" Maximum="99" Value="1" FormatString="0" Width="110"
                         AutomationProperties.Name="Step number"/>
        </StackPanel>

        <TextBlock Text="About this capture" FontWeight="SemiBold" Margin="0,10,0,0"/>
        <TextBox x:Name="TitleBox" AutomationProperties.Name="Title" Watermark="Title"/>
        <TextBox x:Name="TagsBox" AutomationProperties.Name="Tags" Watermark="Tags, e.g. bug invoice"/>
        <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140"
                 AutomationProperties.Name="Description" Watermark="Description (searchable)"/>
        <TextBlock x:Name="SourceText" FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
        <TextBlock x:Name="OcrText" FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
        <Button x:Name="CopyTextButton" Content="Copy all text" HorizontalAlignment="Left" IsEnabled="False"
                AutomationProperties.Name="Copy all text" ToolTip.Tip="Copy every line of text found in the picture"/>

        <TextBlock Text="✨ AI" FontWeight="SemiBold" Margin="0,10,0,0"/>
        <TextBox x:Name="AiBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140"
                 AutomationProperties.Name="AI instruction"
                 Watermark="Tell the AI what to do, e.g. “redact all email addresses” or “number the buttons”"/>
        <DockPanel>
          <Button x:Name="AiApplyButton" DockPanel.Dock="Right" Content="Edit with AI" Classes="accent" Click="AiEdit_Click"
                  ToolTip.Tip="The AI reads the text of the picture (OCR) and the annotations, and changes them"/>
          <Button x:Name="AiDescribeButton" Content="Title and tags" HorizontalAlignment="Left" Click="AiDescribe_Click"
                  ToolTip.Tip="Let the AI suggest a title, tags and a description from the text in the picture"/>
        </DockPanel>
        <TextBlock x:Name="AiStatus" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
        <WrapPanel x:Name="AiExamples"/>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="Viewer" Background="#262626" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Grid x:Name="SurfaceHost"/>
    </ScrollViewer>
  </DockPanel>
</Window>
