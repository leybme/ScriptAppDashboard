<views:ShellTab xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:views="using:ScriptAppDashboard.Views"
        x:Class="ScriptAppDashboard.Views.AppsView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="14,10" Background="#18808080">
      <DockPanel>
        <WrapPanel VerticalAlignment="Center">
          <Button AutomationProperties.Name="Add Script" Classes="accent" Margin="0,2,8,2" Click="AddButton_Click"
                  ToolTip.Tip="Add a script or program tile">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16"/>
              <TextBlock Text="Add Script" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button AutomationProperties.Name="Scan" Margin="0,2,8,2" Click="ScanButton_Click"
                  ToolTip.Tip="Find scripts and apps that are running right now and add them as tiles">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Kind="Radar" Width="16" Height="16"/>
              <TextBlock Text="Scan" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button AutomationProperties.Name="AI Script" Margin="0,2,8,2" Click="AiScriptButton_Click"
                  ToolTip.Tip="Describe a script and let AI write it; you review it before it's saved as a tile">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Kind="CreationOutline" Width="16" Height="16"/>
              <TextBlock Text="AI Script" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="CopyTimeButton" AutomationProperties.Name="Copy time" Margin="0,2,8,2" Click="CopyTimeButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Kind="ClockOutline" Width="16" Height="16"/>
              <TextBlock Text="Copy time" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </WrapPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="14,6">
      <DockPanel>
        <TextBlock x:Name="StatusText" FontSize="12" Foreground="Gray" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Text="Tip: click a tile to run it, right-click to edit. Closing the window hides the app to the tray."/>
      </DockPanel>
    </Border>

    <Panel>
      <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextAlignment="Center" Foreground="Gray"
                 Text="No scripts yet.&#10;&#10;Click “Add Script” to pick a .py / .ps1 / .sh / .bat / .exe,&#10;or “Scan” to grab scripts and apps that are already running."/>
      <ScrollViewer>
        <WrapPanel x:Name="TileHost" Margin="10"/>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</views:ShellTab>
