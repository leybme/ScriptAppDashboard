<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScriptAppDashboard.Views.IconPickerWindow"
        Title="Choose an Icon"
        Width="660" Height="500"
        Icon="/Assets/icon.png"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <TextBox x:Name="SearchBox" DockPanel.Dock="Top"
             Watermark="Search 7,000+ Material Design icons… (e.g. python, database, robot, chart)"
             TextChanged="SearchBox_Changed"/>
    <TextBlock x:Name="ResultInfo" DockPanel.Dock="Bottom" Foreground="Gray" FontSize="12" Margin="0,8,0,0"/>
    <ScrollViewer Margin="0,10,0,0">
      <WrapPanel x:Name="IconHost"/>
    </ScrollViewer>
  </DockPanel>
</Window>
