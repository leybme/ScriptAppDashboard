<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ScriptAppDashboard</RootNamespace>
    <AssemblyName>ScriptAppDashboard</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Authors>Y Nguyen</Authors>
    <Copyright>Copyright (c) 2026 Y Nguyen. PolyForm Noncommercial 1.0.0; commercial use needs a license.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- the license travels with every release zip, next to the executable -->
    <None Include="LICENSE.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.0" />
  </ItemGroup>

</Project>
